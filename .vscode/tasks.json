{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Studio：启动桌面应用（无需调试器）",
      "type": "process",
      "command": "${workspaceFolder}\\.build-env\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\pixelrag_studio.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "检查：语法与最小测试",
      "type": "process",
      "command": "${workspaceFolder}\\.build-env\\Scripts\\python.exe",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Hybrid：完整处理当前文件",
      "type": "process",
      "command": "${workspaceFolder}\\.build-env\\Scripts\\python.exe",
      "args": [
        "-m",
        "hybrid_input",
        "ingest",
        "${file}",
        "--output",
        "${workspaceFolder}\\.hybrid-output\\ingest"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
